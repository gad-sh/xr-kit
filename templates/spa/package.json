{
  "name": "spa",
  "private": true,
  "version": "0.0.0",
  "description": "A mostly-2D single page app built with @gadxr/ui and SvelteKit, with a VR section that loads A-Frame only when it's opened.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@gadxr/ui": "^0.1.1",
    "aframe": "^1.8.0",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "svelte-check": "^4.4.6",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-plugin-mkcert": "^2.1.0"
  }
}
